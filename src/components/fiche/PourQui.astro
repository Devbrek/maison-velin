---
// « Pour quelles marques » + « La pièce contient »
import type { CollectionEntry } from 'astro:content';

interface Props {
  data: CollectionEntry<'pieces'>['data'];
}

const { pourQui, contenu } = Astro.props.data;
---

<section aria-labelledby="pour-qui" class="conteneur grid items-start gap-x-30 gap-y-16 py-24 md:py-[140px] lg:grid-cols-2">
  <div class="flex flex-col gap-6">
    <p class="surtitre text-ink-2">{pourQui.surtitre}</p>
    <h2 id="pour-qui" class="font-display text-[clamp(30px,3.2vw,48px)] leading-[1.2]">{pourQui.titre}</h2>
    <p class="paragraphe text-ink-2">{pourQui.texte}</p>
  </div>
  <div>
    <h3 class="surtitre mb-4 text-ink-2">La pièce contient</h3>
    <ul class="border-b border-ink/12">
      {contenu.map(({ nom, detail }) => (
        <li class="flex justify-between gap-6 border-t border-ink/12 py-5 text-[17px]">
          <span>{nom}</span>
          <span class="text-right font-light text-ink-2">{detail}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
