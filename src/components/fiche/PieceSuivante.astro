---
/*
 * Carte « pièce suivante » : la collection tourne en boucle (Filigrane → Vecteur → Lavis → Filigrane).
 * Même comportement que les blocs de l'accueil : toute la carte mène à la fiche (lien étiré),
 * photo floue → nette et texte en cascade à l'arrivée, photo agrandie et voile plus sombre au survol.
 */
import type { CollectionEntry } from 'astro:content';
import Photo from '../Photo.astro';
import NomPiece from './NomPiece.astro';
import LienPiece from '../velin/LienPiece.astro';

interface Props {
  piece: CollectionEntry<'pieces'>;
}

const { id, data } = Astro.props.piece;
---

<section
  aria-labelledby="piece-suivante"
  data-apparition
  class="suivante bloc-piece group relative isolate flex min-h-[420px] overflow-hidden bg-[#161513] text-sur-image md:min-h-[520px]"
>
  <div class="net absolute inset-0 -z-10 overflow-hidden md:left-auto md:w-3/5">
    <Photo
      src={data.accueil.image}
      alt=""
      sizes="(min-width: 48rem) 60vw, 100vw"
      class="bloc-image absolute inset-0 h-full w-full object-cover"
      style={`object-position: ${data.accueil.position}`}
    />
  </div>
  <div aria-hidden="true" class="voile absolute inset-0 -z-10"></div>
  <div aria-hidden="true" class="bloc-assombri absolute inset-0 -z-10 bg-[rgb(22_21_19/0.22)]"></div>
  <div class="conteneur flex flex-col justify-end gap-4 py-18">
    <p class="apparait depuis-bas surtitre text-sur-image-3">Pièce suivante</p>
    <h2 id="piece-suivante" class="apparait depuis-bas delai-1">
      <NomPiece id={id} nom={data.nom} police={data.policeNom} />
    </h2>
    <p class="apparait depuis-bas delai-2 text-[12px] tracking-[0.22em] text-brume uppercase">{data.univers.join(' · ')}</p>
    <div class="apparait depuis-bas delai-3 flex pt-2">
      <LienPiece href={`/collection/${id}`} nom={data.nom} police={data.policeNom} />
    </div>
  </div>
</section>

<style>
  .voile {
    background: linear-gradient(to top, #161513 0%, rgb(22 21 19 / 0.75) 45%, rgb(22 21 19 / 0.2) 100%);
  }
  @media (width >= 48rem) {
    .suivante {
      clip-path: polygon(0 0, 100% 0, 100% 88%, 95% 100%, 0 100%);
    }
    .voile {
      background: linear-gradient(to right, #161513 0%, #161513 40%, rgb(22 21 19 / 0.2) 70%);
    }
  }
</style>
