---
/*
 * Les preuves : scores Lighthouse (non mesurés tant que le site n'est pas en ligne) + engagements.
 * Aucun faux chiffre : les scores restent « [—] » jusqu'à la mesure réelle.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  preuves: CollectionEntry<'pieces'>['data']['preuves'];
}

const { mention, engagements } = Astro.props.preuves;
const scores = ['Performance', 'Accessibilité', 'Bonnes pratiques', 'SEO'];
---

<section aria-labelledby="preuves" class="conteneur grid gap-x-30 gap-y-16 py-24 md:py-[140px] lg:grid-cols-2">
  <div class="flex flex-col gap-8">
    <h2 id="preuves" class="font-display text-[clamp(30px,3.2vw,48px)]">Les preuves</h2>
    <dl class="grid grid-cols-2 gap-8">
      {scores.map((libelle) => (
        <div class="flex flex-col-reverse gap-2">
          <dt class="text-[12px] tracking-[0.22em] text-ink-2 uppercase">{libelle}</dt>
          <dd class="font-display text-5xl">
            <span aria-hidden="true">[—]</span><span class="sr-only">à mesurer</span>
          </dd>
        </div>
      ))}
    </dl>
    <p class="text-sm text-ink-2">{mention}</p>
  </div>
  <div>
    <h3 class="surtitre mb-4 text-ink-2">Engagements</h3>
    <ul class="border-b border-ink/12">
      {engagements.map((texte) => (
        <li class="border-t border-ink/12 py-5 text-[17px] leading-[1.6] font-light">{texte}</li>
      ))}
    </ul>
  </div>
</section>
