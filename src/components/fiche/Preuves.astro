---
/*
 * Les preuves : scores Lighthouse de la démo de la pièce, mesurés sur le site en ligne
 * (src/data/mesures-lighthouse.json), + engagements.
 */
import type { CollectionEntry } from 'astro:content';
import LienRapport from '../LienRapport.astro';
import { CATEGORIES, dateMesure, mesureDe } from '../../lib/mesures';

interface Props {
  preuves: CollectionEntry<'pieces'>['data']['preuves'];
  demo: CollectionEntry<'pieces'>['data']['marqueDemo'];
}

const { preuves, demo } = Astro.props;
const mesure = mesureDe(demo.href);
---

<section aria-labelledby="preuves" class="conteneur grid gap-x-30 gap-y-16 py-24 md:py-[140px] lg:grid-cols-2">
  <div class="flex flex-col gap-8">
    <h2 id="preuves" class="font-display text-[clamp(30px,3.2vw,48px)]">Les preuves</h2>
    <dl class="grid grid-cols-2 gap-8">
      {
        CATEGORIES.map(([cle, libelle]) => (
          <div class="flex flex-col-reverse gap-2">
            <dt class="text-[12px] tracking-[0.22em] text-ink-2 uppercase">{libelle}</dt>
            <dd class="font-display text-5xl">
              {mesure.scores[cle]}
              <span class="sr-only"> sur 100</span>
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="text-sm leading-[1.7] text-ink-2">
      Scores Lighthouse de la démo {demo.nom}, mesurés le {dateMesure()} sur mobile.{' '}
      <LienRapport href={mesure.rapport}>Voir le rapport PageSpeed</LienRapport>
    </p>
  </div>
  <div>
    <h3 class="surtitre mb-4 text-ink-2">Engagements</h3>
    <ul class="border-b border-ink/12">
      {preuves.engagements.map((texte) => <li class="paragraphe border-t border-ink/12 py-5">{texte}</li>)}
    </ul>
  </div>
</section>
