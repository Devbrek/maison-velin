---
/*
 * Ouverture plein écran de l'accueil.
 * En attendant la vidéo (macro lente sur un cadran, une carrosserie, un drapé), une photo.
 */
import Photo from '../Photo.astro';
import photo from '../../assets/aubrek/aubrek-pluie.jpg';
---

<section
  aria-labelledby="hero-titre"
  class="texte-sur-image relative flex min-h-[max(560px,100svh)] flex-col bg-[#2B2723] text-sur-image"
>
  <Photo
    src={photo}
    alt=""
    sizes="100vw"
    priority
    class="absolute inset-0 h-full w-full object-cover"
    style="object-position: center 45%"
  />
  <!-- Voile : le texte reste lisible quelle que soit la zone de la photo -->
  <div aria-hidden="true" class="voile absolute inset-0"></div>

  <div class="conteneur relative mt-auto flex flex-wrap items-end justify-between gap-10 pt-32 pb-12 md:pb-18">
    <div class="flex max-w-[760px] flex-col gap-8">
      <p class="surtitre text-sur-image-3">Templates pour maisons de luxe</p>
      <h1 id="hero-titre" class="font-display text-[clamp(40px,5vw,76px)] leading-[1.02] tracking-[-0.02em]">
        Des pages façonnées comme des <em>pièces rares.</em>
      </h1>
      <p class="max-w-[480px] text-lg leading-[1.7] font-light text-sur-image-2">
        Maison Vélin dessine des sites pour l'horlogerie, l'automobile et l'hôtellerie. Chaque pièce est pensée pour
        un univers, puis ajustée au vôtre.
      </p>
      <a href="#collection" class="bouton-contour self-start">Découvrir la collection</a>
    </div>
    <a href="#manifeste" class="lien-trace text-[11px] tracking-[0.32em] text-sur-image-3 uppercase">Défiler</a>
  </div>
</section>

<style>
  /* Téléphone : texte en bas, voile fort du bas vers le haut */
  .voile {
    background: linear-gradient(to top, rgb(15 14 12 / 0.94) 0%, rgb(15 14 12 / 0.86) 50%, rgb(15 14 12 / 0.6) 100%);
  }
  /* Grand écran : texte à gauche, voile fort à gauche ; bande sombre en haut pour l'en-tête */
  @media (width >= 48rem) {
    .voile {
      background:
        linear-gradient(to bottom, rgb(15 14 12 / 0.6) 0%, rgb(15 14 12 / 0) 18%),
        linear-gradient(to right, rgb(15 14 12 / 0.9) 0%, rgb(15 14 12 / 0.74) 40%, rgb(15 14 12 / 0.15) 66%);
    }
  }
</style>
