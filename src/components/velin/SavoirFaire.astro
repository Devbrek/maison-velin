---
// Les trois principes de la maison (accueil et /savoir-faire)
interface Props {
  titre?: string; // titre de la section (HTML autorisé pour le retour à la ligne)
}

const { titre = 'Le<br />Savoir-faire' } = Astro.props;

const principes = [
  { titre: 'Retenue', texte: 'Une idée par écran, un seul accent de couleur.' },
  { titre: 'Lenteur', texte: 'Des gestes lents, coupés si vous réduisez les animations.' },
  { titre: 'Exigence', texte: 'Accessible et rapide au téléphone. Scores : [À MESURER].' },
];
---

<section id="savoir-faire" aria-labelledby="sf-titre">
  <div class="conteneur grid items-start gap-x-20 gap-y-16 py-24 md:grid-cols-2 md:py-[140px] lg:grid-cols-4">
    <h2 id="sf-titre" class="font-display text-[clamp(36px,4vw,60px)] leading-none" set:html={titre} />
    {principes.map(({ titre, texte }) => (
      <div class="flex flex-col gap-4 pt-3">
        <h3 class="surtitre">{titre}</h3>
        <p class="paragraphe text-ink-2">{texte}</p>
      </div>
    ))}
  </div>
</section>
