---
// Les trois principes de la maison (réutilisé sur /savoir-faire)
const principes = [
  { titre: 'Retenue', texte: 'Une idée par écran. Un seul accent de couleur, posé là où il compte.' },
  { titre: 'Lenteur', texte: "Des mouvements longs et doux, qui s'effacent pour qui préfère réduire les animations." },
  {
    titre: 'Exigence',
    texte: 'Accessibles, rapides et lisibles au téléphone. Chaque pièce publie ses scores : [RÉSULTATS LIGHTHOUSE À MESURER].',
  },
];
---

<section id="savoir-faire" aria-labelledby="sf-titre">
  <div class="conteneur grid items-start gap-x-20 gap-y-16 py-24 md:grid-cols-2 md:py-[140px] lg:grid-cols-4">
    <h2 id="sf-titre" class="font-display text-[clamp(36px,4vw,60px)] leading-none">Le<br />Savoir-faire</h2>
    {principes.map(({ titre, texte }) => (
      <div class="flex flex-col gap-4 pt-3">
        <h3 class="surtitre">{titre}</h3>
        <p class="text-[17px] leading-[1.7] font-light text-ink-2">{texte}</p>
      </div>
    ))}
  </div>
</section>
