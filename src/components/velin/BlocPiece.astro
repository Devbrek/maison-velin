---
/*
 * Bloc d'une pièce sur l'accueil : photo plein cadre, voile en dégradé, texte posé dessus.
 * Le nom de la pièce est écrit dans la police de sa propre identité.
 * Sur téléphone, le texte est toujours en bas ; sur grand écran, il suit la « mise » de la maquette.
 * Tout le bloc mène à la fiche (lien étiré « Découvrir la pièce »). À l'arrivée : photo floue → nette,
 * texte en cascade ; au survol : photo agrandie, voile plus sombre, flèche qui glisse.
 */
import type { CollectionEntry } from 'astro:content';
import Photo from '../Photo.astro';
import NomPiece from '../fiche/NomPiece.astro';
import LienPiece from './LienPiece.astro';

interface Props {
  piece: CollectionEntry<'pieces'>;
}

const { piece } = Astro.props;
const { id, data } = piece;

const alignement = {
  'bas-gauche': 'md:items-end md:justify-start',
  droite: 'md:items-center md:justify-end',
  'haut-gauche': 'md:items-start md:justify-start',
}[data.accueil.mise];
---

<article
  aria-labelledby={`piece-${id}`}
  data-apparition
  class:list={['bloc bloc-piece group relative isolate flex min-h-[640px] overflow-hidden bg-[#2B2723] text-sur-image md:min-h-[820px]', `bloc--${data.accueil.mise}`]}
>
  <!-- Deux couches : l'enveloppe passe du flou au net à l'arrivée, l'image s'agrandit au survol -->
  <div class="net absolute inset-0 -z-10">
    <Photo
      src={data.accueil.image}
      alt=""
      sizes="100vw"
      class="bloc-image absolute inset-0 h-full w-full object-cover"
      style={`object-position: ${data.accueil.position}`}
    />
  </div>
  <div aria-hidden="true" class="voile absolute inset-0 -z-10"></div>
  <div aria-hidden="true" class="bloc-assombri absolute inset-0 -z-10 bg-[rgb(15_14_12/0.22)]"></div>

  <div class:list={['conteneur flex items-end py-18', alignement]}>
    <div class="flex max-w-[460px] flex-col gap-5">
      <p class="apparait depuis-bas surtitre text-sur-image-3">{data.univers.join(' · ')}</p>
      <NomPiece id={id} nom={data.nom} police={data.policeNom} niveau="h3" htmlId={`piece-${id}`} class="apparait depuis-bas delai-1" />
      <p class="apparait depuis-bas delai-2 text-[17px] leading-[1.7] font-light text-sur-image-2">{data.accueil.accroche}</p>
      <div class="apparait depuis-bas delai-3 flex">
        <LienPiece href={`/collection/${id}`} nom={data.nom} police={data.policeNom} />
      </div>
    </div>
  </div>
</article>

<style>
  /* Téléphone : voile du bas vers le haut, sous le texte */
  .voile {
    background: linear-gradient(to top, rgb(15 14 12 / 0.92) 0%, rgb(15 14 12 / 0.78) 45%, rgb(15 14 12 / 0) 80%);
  }

  @media (width >= 48rem) {
    .bloc--bas-gauche .voile {
      background: linear-gradient(to top right, rgb(15 14 12 / 0.9) 0%, rgb(15 14 12 / 0.72) 34%, rgb(15 14 12 / 0) 66%);
    }
    .bloc--droite {
      clip-path: polygon(0 0, 100% 0, 100% 92%, 94% 100%, 0 100%);
    }
    .bloc--droite .voile {
      background: linear-gradient(to left, rgb(15 14 12 / 0.92) 0%, rgb(15 14 12 / 0.8) 36%, rgb(15 14 12 / 0.15) 72%);
    }
    .bloc--haut-gauche .voile {
      background: linear-gradient(to bottom right, rgb(30 20 11 / 0.92) 0%, rgb(30 20 11 / 0.7) 32%, rgb(30 20 11 / 0) 62%);
    }
  }
</style>
