---
/*
 * En-tête Maison Vélin.
 * Grand écran : logo, navigation, bouton rendez-vous.
 * Téléphone : bouton « Menu » qui ouvre un panneau plein écran (<dialog> natif :
 * focus piégé, touche Échap et fond inerte sont gérés par le navigateur).
 */
import Logo from './Logo.astro';

interface Props {
  surImage?: boolean;
}

const { surImage = false } = Astro.props;

const liens = [
  { href: '/#collection', label: 'La Collection' },
  { href: '/savoir-faire', label: 'Le Savoir-faire' },
  { href: '/sur-mesure', label: 'Sur mesure' },
];

const chemin = Astro.url.pathname.replace(/\/$/, '') || '/';
const estCourant = (href: string) => href === chemin;
---

<header
  class:list={[
    'z-20 border-b',
    surImage ? 'texte-sur-image absolute inset-x-0 top-0 border-sur-image/15 text-sur-image' : 'relative border-line',
  ]}
>
  <div class="conteneur flex items-center justify-between gap-x-10 gap-y-4 py-3 lg:py-4">
    <a href="/" class="flex min-h-11 items-center" aria-label="Maison Vélin by Devbrek, retour à l'accueil">
      <Logo clair={surImage} />
    </a>

    <nav aria-label="Navigation principale" class="hidden lg:block">
      <ul class="flex items-center gap-10 text-[13px] tracking-[0.18em] uppercase">
        {liens.map(({ href, label }) => (
          <li>
            <a class="lien-trace" href={href} aria-current={estCourant(href) ? 'page' : undefined}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="/sur-mesure" class:list={['bouton-contour hidden px-6 lg:inline-flex', !surImage && 'bouton-contour--encre']}>
      Demander une pièce
    </a>

    <button
      type="button"
      class="min-h-11 min-w-11 text-[12px] tracking-[0.22em] uppercase lg:hidden"
      aria-haspopup="dialog"
      aria-controls="menu-mobile"
      data-menu-ouvrir
    >
      Menu
    </button>
  </div>
</header>

<dialog
  id="menu-mobile"
  aria-label="Menu"
  class="menu-mobile m-0 h-dvh max-h-none w-full max-w-none bg-bg p-0 text-ink"
>
  <div class="conteneur flex h-full flex-col py-3">
    <div class="flex items-center justify-between">
      <Logo />
      <button type="button" class="min-h-11 min-w-11 text-[12px] tracking-[0.22em] uppercase" data-menu-fermer>
        Fermer
      </button>
    </div>
    <nav aria-label="Navigation principale" class="flex flex-1 flex-col justify-center">
      <ul class="flex flex-col gap-6">
        {liens.map(({ href, label }) => (
          <li>
            <a class="lien-trace font-display text-[32px]" href={href} aria-current={estCourant(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a href="/sur-mesure" class="bouton-contour bouton-contour--encre self-start">Demander une pièce</a>
  </div>
</dialog>

<style>
  /* Sur fond vélin, le bouton se remplit d'encre au survol */
  .bouton-contour--encre:hover {
    background-color: var(--id-ink);
    color: var(--id-bg);
  }

  .menu-mobile[open] {
    animation: menu-fondu 600ms var(--ease-velin);
  }
  @keyframes menu-fondu {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  // Relancé à chaque navigation (View Transitions remplacent la page sans recharger les scripts)
  document.addEventListener('astro:page-load', () => {
    const menu = document.querySelector<HTMLDialogElement>('#menu-mobile');
    if (!menu) return;

    document.querySelector('[data-menu-ouvrir]')?.addEventListener('click', () => menu.showModal());
    menu.querySelector('[data-menu-fermer]')?.addEventListener('click', () => menu.close());
    // Un lien choisi ferme le menu avant la navigation
    menu.querySelectorAll('a').forEach((lien) => lien.addEventListener('click', () => menu.close()));
  });
</script>
