---
/*
 * Logo Maison Vélin (texte vectorisé : aucune police requise).
 * `navbar` : version simplifiée pour l'en-tête (traits épaissis, sans « BY DEVBREK »), nette dès 40 px.
 * `horizontal` : arche + « MAISON Vélin BY DEVBREK », lisible à partir de 72 px (pied de page).
 * `clair` : version pour fond sombre (photo, mode nuit). Sinon, la version suit le thème :
 * encre sur vélin, et version claire sous [data-theme="nuit"].
 * Décoratif ici (alt vide) : le lien ou le texte voisin porte le nom accessible.
 */
import navbarEncre from '../../assets/logo/navbar.svg';
import navbarClair from '../../assets/logo/navbar-clair.svg';
import horizontalEncre from '../../assets/logo/horizontal.svg';
import horizontalClair from '../../assets/logo/horizontal-clair.svg';

interface Props {
  variante?: 'navbar' | 'horizontal';
  clair?: boolean;
  class?: string;
}

const { variante = 'navbar', clair = false, class: classe } = Astro.props;

const VERSIONS = {
  // 44 px sur téléphone, 56 px en grand écran
  navbar: { encre: navbarEncre, clair: navbarClair, taille: 'h-11 w-auto lg:h-14' },
  // 72 px minimum (sous cette taille, « BY DEVBREK » devient illisible)
  horizontal: { encre: horizontalEncre, clair: horizontalClair, taille: 'h-18 w-auto lg:h-24' },
};
const { encre, clair: versionClaire, taille } = VERSIONS[variante];
---

{
  clair ? (
    <img src={versionClaire.src} width={versionClaire.width} height={versionClaire.height} alt="" class:list={[taille, classe]} />
  ) : (
    <>
      <img src={encre.src} width={encre.width} height={encre.height} alt="" class:list={['logo-jour', taille, classe]} />
      <img src={versionClaire.src} width={versionClaire.width} height={versionClaire.height} alt="" class:list={['logo-nuit hidden', taille, classe]} />
    </>
  )
}

<style>
  :global([data-theme='nuit']) .logo-jour {
    display: none;
  }
  :global([data-theme='nuit']) .logo-nuit {
    display: block;
  }
</style>
