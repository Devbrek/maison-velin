---
/*
 * Layout racine de toutes les pages.
 * Les polices ne sont PAS chargées ici : chaque page (ou layout d'identité)
 * passe ses <Font /> dans le slot « fonts », pour ne charger que ce dont elle a besoin.
 */
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

export type Identity = 'velin' | 'aubrek' | 'calade' | 'sertelle';

interface Props {
  title: string;
  description: string;
  identity?: Identity;
  noindex?: boolean; // page à exclure des moteurs de recherche (ex. 404)
}

const { title, description, identity = 'velin', noindex = false } = Astro.props;
---

<!doctype html>
<html lang="fr" data-identity={identity}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <slot name="fonts" />
    <!-- Avant l'affichage : signale que JS est actif (apparitions) et applique le choix « Réduire les animations » -->
    <script is:inline data-astro-rerun>
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('mouvement') === 'reduit') document.documentElement.dataset.mouvement = 'reduit';
      } catch {}
    </script>
    <ClientRouter />
  </head>
  <body class="min-h-dvh">
    <slot />
    <script>
      import '../scripts/apparitions';
    </script>
  </body>
</html>
