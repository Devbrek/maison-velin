---
import { Font } from 'astro:assets';
import { getCollection } from 'astro:content';
import VelinLayout from '../layouts/VelinLayout.astro';
import HeroAccueil from '../components/velin/HeroAccueil.astro';
import BlocPiece from '../components/velin/BlocPiece.astro';
import SavoirFaire from '../components/velin/SavoirFaire.astro';
import BandeauSurMesure from '../components/velin/BandeauSurMesure.astro';

const pieces = (await getCollection('pieces')).sort((a, b) => a.data.ordre - b.data.ordre);
---

<VelinLayout
  title="Maison Vélin — Templates de sites pour maisons de luxe"
  description="Maison Vélin dessine des templates de sites web haut de gamme pour la joaillerie, l'horlogerie connectée et le parfum. Une création Devbrek."
  enTeteSurImage
>
  <!-- Polices des noms de pièces : Filigrane en Bodoni, Vecteur en Saira, Lavis en Fraunces -->
  <Fragment slot="fonts">
    <Font cssVariable="--font-bodoni" />
    <Font cssVariable="--font-saira" />
    <Font cssVariable="--font-fraunces" />
  </Fragment>

  <HeroAccueil />

  <!-- À propos : ce qu'est Maison Vélin, et comment la visiter -->
  <section id="a-propos" data-apparition aria-labelledby="a-propos-titre" class="scroll-mt-4">
    <div class="conteneur grid gap-x-20 gap-y-10 pt-24 md:grid-cols-3 md:pt-[140px]">
      <p class="apparait depuis-bas surtitre text-ink-2">À propos</p>
      <div class="flex flex-col gap-8 md:col-span-2">
        <h2 id="a-propos-titre" class="apparait depuis-bas delai-1 font-display text-[clamp(32px,3.6vw,52px)] leading-[1.1]">
          Une maison imaginaire, un <span class="whitespace-nowrap">savoir-faire</span> réel.
        </h2>
        <p class="apparait depuis-bas delai-2 paragraphe text-ink-2">
          Maison Vélin est une vitrine créée par Devbrek. Elle présente trois templates de sites de luxe, chacun démontré
          sur une marque fictive.
        </p>
        <ol class="apparait depuis-bas delai-3 max-w-[26em] border-b border-ink/12 text-[clamp(17px,0.9rem+0.45vw,21px)]">
          {
            [
              { numero: 'I', texte: 'Parcourez les trois pièces.' },
              { numero: 'II', texte: 'Ouvrez leurs démos interactives.' },
              { numero: 'III', texte: "Une pièce vous plaît ? Devbrek l'adapte à votre marque.", href: '/sur-mesure' },
            ].map(({ numero, texte, href }) => (
              <li class="grid grid-cols-[48px_1fr] items-baseline gap-4 border-t border-ink/12 py-5">
                <span aria-hidden="true" class="font-display text-xl text-accent">
                  {numero}
                </span>
                {href ? (
                  <a
                    href={href}
                    class="group leading-[1.6] font-light underline decoration-ink/40 decoration-1 underline-offset-[6px] transition-colors duration-[600ms] ease-velin hover:text-accent hover:decoration-current"
                  >
                    {texte}
                    <span
                      aria-hidden="true"
                      class="ml-1 inline-block transition-[translate] duration-[600ms] ease-velin motion-safe:group-hover:translate-x-1"
                    >
                      →
                    </span>
                  </a>
                ) : (
                  <span class="leading-[1.6] font-light">{texte}</span>
                )}
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section id="manifeste" aria-label="La maison">
    <div class="conteneur grid gap-x-20 gap-y-10 py-24 md:grid-cols-3 md:py-[140px]">
      <p class="surtitre text-ink-2">La maison</p>
      <p class="paragraphe font-normal md:col-span-2">
        Une maison de luxe ne crie pas. Nos templates non plus : peu d'éléments, beaucoup d'espace, des gestes lents.
      </p>
    </div>
  </section>

  <section id="collection" aria-labelledby="collection-titre" class="scroll-mt-4">
    <div class="conteneur flex flex-wrap items-baseline justify-between gap-4 pb-16">
      <h2 id="collection-titre" class="font-display text-[clamp(36px,4vw,60px)]">La Collection</h2>
      <p class="surtitre text-ink-2">Trois pièces, trois univers</p>
    </div>
    <div class="flex flex-col gap-2">
      {pieces.map((piece) => <BlocPiece piece={piece} />)}
    </div>
  </section>

  <SavoirFaire />
  <BandeauSurMesure />
</VelinLayout>
