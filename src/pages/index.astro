---
import { Font } from 'astro:assets';
import { getCollection } from 'astro:content';
import VelinLayout from '../layouts/VelinLayout.astro';
import HeroAccueil from '../components/velin/HeroAccueil.astro';
import BlocPiece from '../components/velin/BlocPiece.astro';
import SavoirFaire from '../components/velin/SavoirFaire.astro';
import BandeauSurMesure from '../components/velin/BandeauSurMesure.astro';

const pieces = (await getCollection('pieces')).sort((a, b) => a.data.ordre - b.data.ordre);
---

<VelinLayout
  title="Maison Vélin — Templates de sites pour maisons de luxe"
  description="Maison Vélin dessine des templates de sites web haut de gamme pour la joaillerie, l'horlogerie connectée et le parfum. Une création Devbrek."
  enTeteSurImage
>
  <!-- Polices des noms de pièces : Vecteur en Saira, Lavis en Fraunces -->
  <Fragment slot="fonts">
    <Font cssVariable="--font-saira" />
    <Font cssVariable="--font-fraunces" />
  </Fragment>

  <HeroAccueil />

  <section id="manifeste" aria-label="La maison">
    <div class="conteneur grid gap-x-20 gap-y-10 py-24 md:grid-cols-3 md:py-[140px]">
      <p class="surtitre text-ink-2">La maison</p>
      <p class="font-display text-[clamp(26px,2.6vw,40px)] leading-[1.3] md:col-span-2">
        Une maison de luxe ne crie pas. Elle prend son temps, laisse respirer ses objets et soigne chaque détail. Nos
        templates appliquent ces règles à l'écran : peu d'éléments, beaucoup d'espace, des mouvements lents.
      </p>
    </div>
  </section>

  <section id="collection" aria-labelledby="collection-titre" class="scroll-mt-4">
    <div class="conteneur flex flex-wrap items-baseline justify-between gap-4 pb-16">
      <h2 id="collection-titre" class="font-display text-[clamp(36px,4vw,60px)]">La Collection</h2>
      <p class="surtitre text-ink-2">Trois pièces, trois univers</p>
    </div>
    <div class="flex flex-col gap-2">
      {pieces.map((piece) => <BlocPiece piece={piece} />)}
    </div>
  </section>

  <SavoirFaire />
  <BandeauSurMesure />
</VelinLayout>
