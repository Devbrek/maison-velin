---
/*
 * Mentions légales, données personnelles et crédits photos.
 * Les informations de l'éditeur viennent de src/lib/editeur.ts ; les crédits, de la collection creditsPhotos.
 */
import { getCollection } from 'astro:content';
import VelinLayout from '../layouts/VelinLayout.astro';
import OuvertureSobre from '../components/velin/OuvertureSobre.astro';
import { EDITEUR, HEBERGEUR, ouACompleter } from '../lib/editeur';
import { emailAffiche } from '../lib/contact';

// Seules les photos affichées sur le site sont créditées (les photos de réserve n'ont pas d'utilisation)
const credits = (await getCollection('creditsPhotos'))
  .filter(({ data }) => data.utilisation)
  .sort((a, b) => a.id.localeCompare(b.id));

const editeur = [
  ['Éditeur', ouACompleter(EDITEUR.nom, 'NOM À COMPLÉTER')],
  ['Nom commercial', EDITEUR.nomCommercial],
  ['Statut', ouACompleter(EDITEUR.statut, 'STATUT À COMPLÉTER')],
  ['SIRET', ouACompleter(EDITEUR.siret, 'SIRET À COMPLÉTER')],
  ['Adresse', ouACompleter(EDITEUR.adresse, 'ADRESSE À COMPLÉTER')],
  ['E-mail', emailAffiche],
  ['Téléphone', ouACompleter(EDITEUR.telephone, 'TÉLÉPHONE À COMPLÉTER')],
  ['Directeur de la publication', ouACompleter(EDITEUR.directeurPublication || EDITEUR.nom, 'NOM À COMPLÉTER')],
];

// Classe commune des sections : titre à gauche, contenu à droite (comme les fiches)
const section = 'conteneur grid items-start gap-x-30 gap-y-8 border-t border-line py-16 md:py-20 lg:grid-cols-[1fr_2fr]';
const titre = 'font-display text-[clamp(26px,2.6vw,36px)] leading-[1.2]';
const texte = 'flex max-w-[680px] flex-col gap-4 leading-[1.8] font-light text-ink-2';
---

<VelinLayout
  title="Mentions légales — Maison Vélin"
  description="Mentions légales de Maison Vélin by Devbrek : éditeur, hébergeur, propriété intellectuelle, données personnelles et crédits photos."
>
  <OuvertureSobre
    surtitre="Informations"
    titre="Mentions légales"
    intro="Qui édite ce site, qui l'héberge, ce qu'il fait (et ne fait pas) de vos données, et à qui l'on doit ses photographies."
  />

  <section aria-labelledby="editeur" class={section}>
    <h2 id="editeur" class={titre}>Éditeur</h2>
    <dl class="max-w-[680px] border-b border-ink/12">
      {editeur.map(([cle, valeur]) => (
        <div class="grid gap-x-8 gap-y-1 border-t border-ink/12 py-4 sm:grid-cols-[220px_1fr]">
          <dt class="surtitre text-ink-2">{cle}</dt>
          <dd class="font-light">{valeur}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section aria-labelledby="hebergement" class={section}>
    <h2 id="hebergement" class={titre}>Hébergement</h2>
    <div class={texte}>
      <p>
        Ce site est hébergé par <span class="text-ink">{HEBERGEUR.nom}</span>, {HEBERGEUR.adresse} —
        <a class="text-ink underline underline-offset-3 hover:text-accent" href={HEBERGEUR.site}>vercel.com</a>.
      </p>
    </div>
  </section>

  <section aria-labelledby="propriete" class={section}>
    <h2 id="propriete" class={titre}>Propriété intellectuelle</h2>
    <div class={texte}>
      <p>
        La conception, les textes et le code de Maison Vélin sont l'œuvre de Devbrek. Toute reproduction sans
        autorisation est interdite.
      </p>
      <p>
        <span class="text-ink">Sertelle, Aubrek et Calade sont des marques fictives</span>, créées pour démontrer les
        pièces Filigrane, Vecteur et Lavis. Les produits, prix et caractéristiques présentés sont imaginaires ; toute
        ressemblance avec une marque existante serait fortuite.
      </p>
      <p>
        Les polices de caractères (Bodoni Moda, Jost, Saira, Fraunces, Manrope, Cormorant Garamond, Hanken Grotesk, EB
        Garamond, Playfair Display, Exo 2, Titillium Web) sont distribuées sous licence libre SIL Open Font License et
        servies depuis ce site.
      </p>
      <p>
        Les photographies proviennent de Pexels et sont utilisées selon la{' '}
        <a class="text-ink underline underline-offset-3 hover:text-accent" href="https://www.pexels.com/license/">licence Pexels</a>.
        Leurs auteurs sont crédités ci-dessous.
      </p>
    </div>
  </section>

  <section aria-labelledby="donnees" class={section}>
    <h2 id="donnees" class={titre}>Données personnelles</h2>
    <div class={texte}>
      <p>
        <span class="text-ink">Ce site ne dépose aucun cookie et n'utilise aucun outil de mesure d'audience.</span>{' '}
        Il ne collecte ni ne conserve aucune donnée personnelle.
      </p>
      <p>
        Le formulaire « Sur mesure » ne transmet rien au site : il prépare un e-mail dans votre propre messagerie, que vous
        choisissez d'envoyer ou non. Les informations que vous y écrivez servent uniquement à répondre à votre demande.
      </p>
      <p>
        Si vous choisissez de réduire les animations, ce réglage est gardé dans votre navigateur (stockage local), sur votre
        appareil uniquement. Les polices sont servies par ce site, sans appel à un service tiers.
      </p>
      <p>
        Comme tout hébergeur, Vercel enregistre des journaux techniques (dont l'adresse IP) pour assurer le fonctionnement
        et la sécurité du service.
      </p>
      <p>
        Pour toute question, ou pour exercer vos droits d'accès, de rectification et d'effacement : {emailAffiche}.
      </p>
    </div>
  </section>

  <section id="credits" aria-labelledby="credits-titre" class:list={[section, 'scroll-mt-4']}>
    <h2 id="credits-titre" class={titre}>Crédits photos</h2>
    <ul class="max-w-[680px] border-b border-ink/12">
      {credits.map(({ data }) => (
        <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-t border-ink/12 py-4">
          <a class="font-light text-ink underline underline-offset-3 hover:text-accent" href={data.url}>
            {data.nomAuteur}<span class="sr-only"> (photo sur Pexels)</span>
          </a>
          <span class="text-sm text-ink-2">{data.utilisation}</span>
        </li>
      ))}
    </ul>
  </section>

  <p class="conteneur border-t border-line py-10 text-sm text-ink-2">Dernière mise à jour : novembre 2026.</p>
</VelinLayout>
