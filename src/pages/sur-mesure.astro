---
/*
 * Sur mesure : Maison Vélin est une vitrine, sans formulaire.
 * Les demandes se font sur le site de Devbrek (lien avec ?source=maison-velin).
 */
import VelinLayout from '../layouts/VelinLayout.astro';
import OuvertureSobre from '../components/velin/OuvertureSobre.astro';
import { EDITEUR, lienDemandeDevbrek } from '../lib/editeur';

const deroule = [
  { numero: 'I', texte: 'Vous décrivez votre maison et votre projet sur le formulaire de Devbrek.' },
  { numero: 'II', texte: 'Devbrek vous répond pour fixer un premier échange, en visio ou par téléphone.' },
  { numero: 'III', texte: 'Vous recevez une proposition : la pièce, les ajustements, le calendrier.' },
];
---

<VelinLayout
  title="Sur mesure — Maison Vélin"
  og="sur-mesure"
  ogAlt="Logo Maison Vélin et titre « Sur mesure » sur fond vélin"
  description="Demandez une pièce Maison Vélin ajustée à votre maison, ou une création entièrement sur mesure par Devbrek."
>
  <OuvertureSobre
    surtitre="Sur mesure"
    titre="Une pièce pour votre maison"
    intro="Chaque template peut être ajusté à votre identité, ou dessiné entièrement pour vous par Devbrek. Dites-nous en quelques lignes ce que vous préparez."
  />

  <section aria-labelledby="deroule" class="border-t border-line">
    <div class="conteneur grid items-start gap-x-30 gap-y-12 py-20 md:py-28 lg:grid-cols-[1fr_2fr]">
      <h2 id="deroule" class="font-display text-[clamp(28px,2.8vw,40px)] leading-[1.2]">Comment ça se passe</h2>
      <div class="flex max-w-[680px] flex-col gap-10">
        <ol class="border-b border-ink/12">
          {deroule.map(({ numero, texte }) => (
            <li class="grid grid-cols-[48px_1fr] gap-4 border-t border-ink/12 py-6">
              <span aria-hidden="true" class="font-display text-xl text-accent italic">{numero}</span>
              <p class="text-[17px] leading-[1.7] font-light">{texte}</p>
            </li>
          ))}
        </ol>

        <a
          href={lienDemandeDevbrek}
          class="group inline-flex min-h-11 items-center gap-3 self-start border border-current px-7 text-[12px] tracking-[0.22em] uppercase transition-colors duration-[900ms] ease-velin hover:bg-ink hover:text-bg focus-visible:bg-ink focus-visible:text-bg"
        >
          Faire une demande sur Devbrek
          <span
            aria-hidden="true"
            class="inline-block transition-[translate] duration-[900ms] ease-velin motion-safe:group-hover:translate-x-1.5 motion-safe:group-focus-visible:translate-x-1.5"
          >
            →
          </span>
        </a>

        <p class="border-t border-line pt-6 text-sm leading-[1.7] text-ink-2">
          Maison Vélin est la vitrine des templates de{' '}
          <a href={EDITEUR.site} class="text-ink underline underline-offset-3 hover:text-accent">Devbrek</a>.
          Votre demande est adressée à Devbrek.
        </p>
      </div>
    </div>
  </section>
</VelinLayout>
